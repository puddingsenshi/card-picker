{
  "name": "@puddingsenshi/card-picker",
  "version": "0.2.0",
  "description": "扇形／線性排列的選卡互動元件。與任何牌組領域無關。",
  "keywords": [
    "react",
    "card",
    "fan-layout",
    "picker",
    "gesture",
    "mediapipe"
  ],
  "license": "MIT",
  "author": "puddingsenshi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puddingsenshi/card-picker.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/fan-layout.css",
    "./pointer": {
      "types": "./dist/pointer/index.d.ts",
      "import": "./dist/pointer/index.js"
    },
    "./hand": {
      "types": "./dist/hand/index.d.ts",
      "import": "./dist/hand/index.js"
    }
  },
  "scripts": {
    "build": "tsup && cp src/fan-layout.css dist/fan-layout.css",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "react": "^19.2.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  }
}
